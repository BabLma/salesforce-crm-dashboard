# Salesforce OAuth Configuration (Frontend)
# Get these from your Salesforce Connected App
VITE_SALESFORCE_CLIENT_ID=YOUR_CONSUMER_KEY_HERE
VITE_SALESFORCE_CALLBACK_URL=http://localhost:3000/callback
VITE_SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Salesforce API Configuration (Frontend)
VITE_SALESFORCE_API_VERSION=v58.0
VITE_PROXY_URL=http://localhost:3001

# Backend Configuration (DO NOT expose in frontend)
SALESFORCE_CLIENT_SECRET=YOUR_CONSUMER_SECRET_HERE
SALESFORCE_CLIENT_ID=YOUR_CONSUMER_KEY_HERE

# Production Environment (set these in Render dashboard)
NODE_ENV=production
PORT=3001
